{
	"info": {
		"name": "Ride Management Service",
		"description": "Postman collection for the RideLink ride-management-service REST API (CRUD operations on /api/rides).",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:8080",
			"type": "string"
		},
		{
			"key": "rideId",
			"value": "",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "Get All Rides",
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/api/rides",
					"host": ["{{baseUrl}}"],
					"path": ["api", "rides"]
				}
			},
			"response": []
		},
		{
			"name": "Get Ride By Id",
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/api/rides/{{rideId}}",
					"host": ["{{baseUrl}}"],
					"path": ["api", "rides", "{{rideId}}"]
				}
			},
			"response": []
		},
		{
			"name": "Create Ride",
			"event": [
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"if (pm.response.code === 201) {",
							"    const body = pm.response.json();",
							"    pm.collectionVariables.set(\"rideId\", body.id);",
							"}"
						]
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"passengerId\": \"P001\",\n    \"driverId\": \"D001\",\n    \"pickupLocation\": \"Colombo\",\n    \"dropoffLocation\": \"Kandy\",\n    \"status\": \"REQUESTED\"\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/api/rides",
					"host": ["{{baseUrl}}"],
					"path": ["api", "rides"]
				}
			},
			"response": []
		},
		{
			"name": "Update Ride",
			"request": {
				"method": "PUT",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"passengerId\": \"P001\",\n    \"driverId\": \"D001\",\n    \"pickupLocation\": \"Colombo\",\n    \"dropoffLocation\": \"Kandy\",\n    \"status\": \"IN_PROGRESS\"\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/api/rides/{{rideId}}",
					"host": ["{{baseUrl}}"],
					"path": ["api", "rides", "{{rideId}}"]
				}
			},
			"response": []
		},
		{
			"name": "Delete Ride",
			"request": {
				"method": "DELETE",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/api/rides/{{rideId}}",
					"host": ["{{baseUrl}}"],
					"path": ["api", "rides", "{{rideId}}"]
				}
			},
			"response": []
		}
	]
}
