{
  "info": {
    "_postman_id": "b7c2512a-8742-45e8-b80c-783ea7483b19",
    "name": "RideLink - Account Service API",
    "description": "Comprehensive Postman test collection for RideLink Account Microservice (Member 1), covering positive and negative scenarios for registration, login, JWT authentication, profile management, and account lookup.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8081",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "accountId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Register Passenger (Positive)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 201 Created\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "pm.test(\"Account response has valid fields\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.have.property('id');",
              "    pm.expect(jsonData.email).to.eql('john.passenger@example.com');",
              "    pm.expect(jsonData.role).to.eql('PASSENGER');",
              "    pm.expect(jsonData.status).to.eql('ACTIVE');",
              "    pm.expect(jsonData).to.not.have.property('password');",
              "    if (jsonData.id) {",
              "        pm.collectionVariables.set('accountId', jsonData.id);",
              "    }",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"firstName\": \"John\",\n  \"lastName\": \"Perera\",\n  \"email\": \"john.passenger@example.com\",\n  \"password\": \"Password123\",\n  \"phone\": \"0771234567\",\n  \"role\": \"PASSENGER\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/accounts/register",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "accounts",
            "register"
          ]
        }
      }
    },
