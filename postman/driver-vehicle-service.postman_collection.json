          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "url": "{{baseUrl}}/api/drivers",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"\",\n  \"phone\": \"not-a-phone\",\n  \"licenseNumber\": \"\",\n  \"serviceArea\": \"\"\n}"
            }
          }
        },
        {
          "name": "Get Driver by ID (Success)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('Driver id matches', () => {",
                  "    pm.expect(pm.response.json().id).to.eql(pm.collectionVariables.get('driverId'));",
                  "});"
                ]
              }
            }
