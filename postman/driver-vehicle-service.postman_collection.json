  "item": [
    {
      "name": "Drivers",
      "item": [
        {
          "name": "Create Driver (Success)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201 CREATED', () => pm.response.to.have.status(201));",
                  "pm.test('Response has id', () => {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.id).to.be.a('string');",
                  "    pm.collectionVariables.set('driverId', json.id);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "url": "{{baseUrl}}/api/drivers",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"accountId\": \"ACC001\",\n  \"name\": \"John Silva\",\n  \"phone\": \"+94771234567\",\n  \"licenseNumber\": \"LIC-12345\",\n  \"serviceArea\": \"Colombo\"\n}"
            }
          }
        },
        {
          "name": "Create Driver — Duplicate License (409)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 409 CONFLICT', () => pm.response.to.have.status(409));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "url": "{{baseUrl}}/api/drivers",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"accountId\": \"ACC002\",\n  \"name\": \"Another Driver\",\n  \"phone\": \"+94779999999\",\n  \"licenseNumber\": \"LIC-12345\",\n  \"serviceArea\": \"Kandy\"\n}"
            }
