        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"rideId\": \"ride-102\",\n  \"passengerId\": \"passenger-502\",\n  \"amount\": 300.0,\n  \"paymentMethod\": \"CARD\",\n  \"simulateFailure\": true\n}"
        },
        "url": {
          "raw": "http://localhost:8084/api/payments",
          "protocol": "http",
